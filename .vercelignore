# Vercel uses this file INSTEAD of .gitignore for CLI uploads, so it
# repeats the .gitignore rules that matter (secrets, build output).
/node_modules
/.pnp
.pnp.*
.yarn/*
/coverage
/.next/
/out/
/build
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
!.env.local.example
!.env.example
*.tsbuildinfo
supabase/.temp/

# The AI voice server runs on its own VM, not on Vercel.
voice-server
